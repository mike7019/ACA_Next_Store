// Esquema de base de datos — Tienda de suplementos deportivos
// PostgreSQL + Prisma ORM

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
//  CATALOGO
// ============================================================

model Categoria {
  id          Int       @id @default(autoincrement())
  nombre      String    @unique @db.VarChar(100)
  slug        String    @unique @db.VarChar(120)
  descripcion String?
  creadoEn    DateTime  @default(now())
  productos   Producto[]

  @@map("categorias")
}

model Producto {
  id             Int      @id @default(autoincrement())
  categoriaId    Int
  categoria      Categoria @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  nombre         String    @db.VarChar(200)
  slug           String    @unique @db.VarChar(220)
  descripcion    String?
  marca          String?   @db.VarChar(100)
  sabor          String?   @db.VarChar(100)
  presentacion   String?   @db.VarChar(100) // ej. "1 kg", "60 caps", "500 ml"
  precio         Decimal   @db.Decimal(10, 2)
  stock          Int       @default(0)
  imagenUrl      String?   @db.VarChar(500)
  destacado      Boolean   @default(false)
  activo         Boolean   @default(true)
  creadoEn       DateTime  @default(now())
  actualizadoEn  DateTime  @updatedAt

  detallePedido  DetallePedido[]

  @@index([categoriaId])
  @@index([activo])
  @@map("productos")
}

// ============================================================
//  CLIENTES
// ============================================================

model Cliente {
  id             Int       @id @default(autoincrement())
  nombre         String    @db.VarChar(100)
  apellido       String    @db.VarChar(100)
  email          String    @unique @db.VarChar(255)
  telefono       String?   @db.VarChar(20)
  fechaRegistro  DateTime  @default(now())
  activo         Boolean   @default(true)

  direcciones    DireccionEnvio[]
  pedidos        Pedido[]

  @@map("clientes")
}

model DireccionEnvio {
  id            Int      @id @default(autoincrement())
  clienteId     Int
  cliente       Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  alias         String?  @db.VarChar(50)
  calle         String   @db.VarChar(255)
  ciudad        String   @db.VarChar(100)
  departamento  String?  @db.VarChar(100)
  codigoPostal  String?  @db.VarChar(20)
  pais          String   @default("Colombia") @db.VarChar(100)
  esPrincipal   Boolean  @default(false)
  creadoEn      DateTime @default(now())

  pedidos       Pedido[]

  @@index([clienteId])
  @@map("direcciones_envio")
}

// ============================================================
//  ENVIOS / METODOS DE ENVIO
// ============================================================

model MetodoEnvio {
  id             Int      @id @default(autoincrement())
  nombre         String   @unique @db.VarChar(100)
  descripcion    String?
  costoBase      Decimal  @default(0) @db.Decimal(10, 2)
  diasEstimados  Int?
  activo         Boolean  @default(true)

  envios         Envio[]

  @@map("metodos_envio")
}

enum EnvioEstado {
  preparando
  despachado
  en_transito
  entregado
  devuelto
}

model Envio {
  id                Int         @id @default(autoincrement())
  pedidoId          Int         @unique
  pedido            Pedido      @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  metodoEnvioId     Int
  metodoEnvio       MetodoEnvio @relation(fields: [metodoEnvioId], references: [id], onDelete: Restrict)
  estado            EnvioEstado @default(preparando)
  numeroGuia        String?     @db.VarChar(100)
  fechaDespacho     DateTime?
  fechaEntregaEst   DateTime?   @db.Date
  fechaEntregaReal  DateTime?
  creadoEn          DateTime    @default(now())
  actualizadoEn     DateTime    @updatedAt

  @@map("envios")
}

// ============================================================
//  PEDIDOS
// ============================================================

enum PedidoEstado {
  pendiente
  confirmado
  en_preparacion
  enviado
  entregado
  cancelado
}

model Pedido {
  id                 Int              @id @default(autoincrement())
  clienteId          Int
  cliente            Cliente          @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  direccionEnvioId   Int?
  direccionEnvio     DireccionEnvio?  @relation(fields: [direccionEnvioId], references: [id], onDelete: SetNull)
  estado             PedidoEstado     @default(pendiente)
  subtotal           Decimal          @db.Decimal(12, 2)
  costoEnvio         Decimal          @default(0) @db.Decimal(10, 2)
  total              Decimal          @db.Decimal(12, 2)
  notas              String?
  creadoEn           DateTime         @default(now())
  actualizadoEn      DateTime         @updatedAt

  detalles           DetallePedido[]
  envio              Envio?
  pago               Pago?

  @@index([clienteId])
  @@index([estado])
  @@map("pedidos")
}

model DetallePedido {
  id           Int      @id @default(autoincrement())
  pedidoId     Int
  pedido       Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  productoId   Int
  producto     Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)
  cantidad     Int
  precioUnit   Decimal  @db.Decimal(10, 2) // precio del producto al momento de la compra
  subtotal     Decimal  @db.Decimal(12, 2) // cantidad * precioUnit, calculado en la app al crear el pedido

  @@unique([pedidoId, productoId])
  @@index([pedidoId])
  @@index([productoId])
  @@map("detalle_pedido")
}

// ============================================================
//  PAGOS
// ============================================================

enum PagoMetodo {
  tarjeta_credito
  tarjeta_debito
  transferencia
  efectivo
  billetera_digital
}

enum PagoEstado {
  pendiente
  aprobado
  rechazado
  reembolsado
}

model Pago {
  id                  Int         @id @default(autoincrement())
  pedidoId            Int         @unique
  pedido              Pedido      @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  metodo              PagoMetodo
  estado              PagoEstado  @default(pendiente)
  monto               Decimal     @db.Decimal(12, 2)
  referenciaExterna   String?     @db.VarChar(200)
  ultimos4Digitos     String?     @db.Char(4)
  fechaPago           DateTime?
  creadoEn            DateTime    @default(now())

  @@map("pagos")
}

// ============================================================
//  ADMINISTRADORES DEL PANEL
// ============================================================

model Admin {
  id            Int      @id @default(autoincrement())
  nombre        String   @db.VarChar(100)
  email         String   @unique @db.VarChar(255)
  passwordHash  String   @db.VarChar(255)
  creadoEn      DateTime @default(now())

  @@map("admins")
}
