<article class="group flex flex-col overflow-hidden rounded-2xl border border-neutral-800 bg-neutral-900 transition hover:border-brand-600">
  <a href="/productos/<%= producto.slug %>" class="block aspect-square overflow-hidden bg-neutral-800">
    <% if (producto.imagenUrl) { %>
      <img src="<%= producto.imagenUrl %>" alt="<%= producto.nombre %>" class="h-full w-full object-cover transition group-hover:scale-105" loading="lazy" />
    <% } else { %>
      <div class="flex h-full w-full items-center justify-center text-sm text-neutral-600">Sin imagen</div>
    <% } %>
  </a>
  <div class="flex flex-1 flex-col gap-2 p-4">
    <% if (producto.marca) { %>
      <p class="text-xs font-semibold uppercase tracking-wide text-brand-500"><%= producto.marca %></p>
    <% } %>
    <a href="/productos/<%= producto.slug %>" class="font-semibold leading-snug hover:text-brand-400"><%= producto.nombre %></a>
    <div class="mt-auto flex items-center justify-between pt-2">
      <span class="text-lg font-bold"><%= formatCOP(producto.precio) %></span>
      <form method="post" action="/carrito/agregar">
        <input type="hidden" name="productoId" value="<%= producto.id %>" />
        <input type="hidden" name="volver" value="<%= currentUrl %>" />
        <button
          type="submit"
          <%= producto.stock <= 0 ? 'disabled' : '' %>
          class="rounded-full bg-brand-500 px-3 py-1.5 text-sm font-semibold text-neutral-950 transition hover:bg-brand-400 disabled:cursor-not-allowed disabled:bg-neutral-700 disabled:text-neutral-400"
        >
          <%= producto.stock <= 0 ? 'Agotado' : 'Agregar' %>
        </button>
      </form>
    </div>
  </div>
</article>
