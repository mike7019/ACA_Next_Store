<%- include('partials/layout-start') %>

<% const heroVideoId = '40mFq3HDQso'; %>
<section class="relative isolate overflow-hidden border-b border-neutral-800 bg-neutral-950">
  <%# Video de fondo: iframe de YouTube en bucle, sin sonido ni controles, escalado para cubrir (cover). %>
  <div class="pointer-events-none absolute inset-0 -z-20" aria-hidden="true">
    <iframe
      class="absolute left-1/2 top-1/2 h-[56.25vw] min-h-full w-[177.78vh] min-w-full -translate-x-1/2 -translate-y-1/2"
      src="https://www.youtube-nocookie.com/embed/<%= heroVideoId %>?autoplay=1&mute=1&loop=1&playlist=<%= heroVideoId %>&controls=0&modestbranding=1&playsinline=1&rel=0&disablekb=1"
      title="Video de fondo"
      allow="autoplay; encrypted-media"
      tabindex="-1"
      loading="lazy"
    ></iframe>
  </div>
  <div class="absolute inset-0 -z-10 bg-gradient-to-b from-neutral-950/70 via-neutral-950/60 to-neutral-950"></div>
  <div class="mx-auto flex max-w-6xl flex-col items-start gap-6 px-4 py-28">
    <p class="text-sm font-semibold uppercase tracking-widest text-brand-500">Rendimiento sin limites</p>
    <h1 class="max-w-2xl text-4xl font-black leading-tight sm:text-5xl">
      Suplementos deportivos para llevar tu entrenamiento al siguiente nivel
    </h1>
    <p class="max-w-xl text-neutral-400">
      Proteinas, creatina, pre-entrenos, aminoacidos y vitaminas de las mejores marcas, con envio a todo el pais.
    </p>
    <a href="/productos" class="rounded-full bg-brand-500 px-6 py-3 font-semibold text-neutral-950 transition hover:bg-brand-400">
      Ver catalogo completo
    </a>
  </div>
</section>

<section class="mx-auto max-w-6xl px-4 py-12">
  <h2 class="mb-6 text-xl font-bold">Categorias</h2>
  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-6">
    <% categorias.forEach((c) => { %>
      <a
        href="/productos?categoria=<%= c.slug %>"
        class="flex items-center justify-center rounded-xl border border-neutral-800 bg-neutral-900 px-4 py-6 text-center text-sm font-semibold text-neutral-200 transition hover:border-brand-500 hover:text-brand-400"
      ><%= c.nombre %></a>
    <% }) %>
  </div>
</section>

<% if (destacados.length > 0) { %>
  <section class="mx-auto max-w-6xl px-4 py-12">
    <div class="mb-6 flex items-center justify-between">
      <h2 class="text-xl font-bold">Destacados</h2>
      <a href="/productos" class="text-sm font-semibold text-brand-500 hover:text-brand-400">Ver todo →</a>
    </div>
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
      <% destacados.forEach((producto) => { %>
        <%- include('partials/product-card', { producto }) %>
      <% }) %>
    </div>
  </section>
<% } %>

<%- include('partials/layout-end') %>
