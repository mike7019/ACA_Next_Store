<%- include('partials/layout-start') %>

<%
  const stats = [
    { label: 'Productos activos', value: String(totalProductos) },
    { label: 'Con poco stock (≤5)', value: String(stockBajo) },
    { label: 'Pedidos pendientes', value: String(pedidosPendientes) },
    { label: 'Clientes registrados', value: String(totalClientes) },
    { label: 'Ventas totales', value: formatCOP(ventasTotales) },
  ];
%>

<div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-5">
  <% stats.forEach((s) => { %>
    <div class="rounded-xl border border-neutral-800 bg-neutral-950 p-5">
      <p class="text-xs uppercase tracking-wide text-neutral-500"><%= s.label %></p>
      <p class="mt-2 text-2xl font-bold"><%= s.value %></p>
    </div>
  <% }) %>
</div>

<div class="mt-10 rounded-xl border border-neutral-800 bg-neutral-950">
  <div class="flex items-center justify-between border-b border-neutral-800 px-5 py-4">
    <h2 class="font-semibold">Ultimos pedidos</h2>
    <a href="/admin/pedidos" class="text-sm text-brand-500 hover:text-brand-400">Ver todos →</a>
  </div>
  <table class="w-full text-sm">
    <thead class="text-left text-neutral-500">
      <tr>
        <th class="px-5 py-3 font-medium">#</th>
        <th class="px-5 py-3 font-medium">Cliente</th>
        <th class="px-5 py-3 font-medium">Estado</th>
        <th class="px-5 py-3 font-medium text-right">Total</th>
      </tr>
    </thead>
    <tbody>
      <% ultimosPedidos.forEach((p) => { %>
        <tr class="border-t border-neutral-800">
          <td class="px-5 py-3"><a href="/admin/pedidos/<%= p.id %>" class="text-brand-500 hover:text-brand-400">#<%= p.id %></a></td>
          <td class="px-5 py-3"><%= p.cliente.nombre %> <%= p.cliente.apellido %></td>
          <td class="px-5 py-3 capitalize"><%= label(p.estado) %></td>
          <td class="px-5 py-3 text-right font-semibold"><%= formatCOP(p.total) %></td>
        </tr>
      <% }) %>
      <% if (ultimosPedidos.length === 0) { %>
        <tr><td colspan="4" class="px-5 py-6 text-center text-neutral-500">Aun no hay pedidos.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<%- include('partials/layout-end') %>
