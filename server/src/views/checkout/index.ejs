<%- include('../partials/layout-start') %>

<%
  const inputClass = 'rounded-lg border border-neutral-700 bg-neutral-900 px-4 py-2';
  const envioSeleccionado = metodosEnvio.find((m) => String(m.id) === valores.metodoEnvioId);
  const costoEnvio = envioSeleccionado ? Number(envioSeleccionado.costoBase) : 0;
%>

<div class="mx-auto max-w-3xl px-4 py-10">
  <h1 class="mb-8 text-2xl font-bold">Finalizar compra</h1>

  <% if (items.length === 0) { %>
    <p class="mb-6 rounded-lg border border-yellow-700 bg-yellow-950/40 px-4 py-3 text-sm text-yellow-300">
      Tu carrito esta vacio. <a href="/productos" class="underline">Ver productos</a>
    </p>
  <% } %>

  <% if (error) { %>
    <p class="mb-6 rounded-lg border border-red-700 bg-red-950/40 px-4 py-3 text-sm text-red-300"><%= error %></p>
  <% } %>

  <form method="post" action="/checkout" class="flex flex-col gap-6">
    <fieldset class="grid gap-4 sm:grid-cols-2">
      <legend class="mb-2 text-sm font-semibold uppercase tracking-wide text-neutral-400">Datos de contacto</legend>
      <input required name="nombre" placeholder="Nombre" value="<%= valores.nombre %>" class="<%= inputClass %>" />
      <input required name="apellido" placeholder="Apellido" value="<%= valores.apellido %>" class="<%= inputClass %>" />
      <input required type="email" name="email" placeholder="Correo electronico" value="<%= valores.email %>" class="<%= inputClass %> sm:col-span-2" />
      <input name="telefono" placeholder="Telefono" value="<%= valores.telefono %>" class="<%= inputClass %> sm:col-span-2" />
    </fieldset>

    <fieldset class="grid gap-4 sm:grid-cols-2">
      <legend class="mb-2 text-sm font-semibold uppercase tracking-wide text-neutral-400">Direccion de envio</legend>
      <input required name="calle" placeholder="Calle / direccion" value="<%= valores.calle %>" class="<%= inputClass %> sm:col-span-2" />
      <input required name="ciudad" placeholder="Ciudad" value="<%= valores.ciudad %>" class="<%= inputClass %>" />
      <input name="departamento" placeholder="Departamento" value="<%= valores.departamento %>" class="<%= inputClass %>" />
      <input name="codigoPostal" placeholder="Codigo postal" value="<%= valores.codigoPostal %>" class="<%= inputClass %>" />
      <input name="pais" placeholder="Pais" value="<%= valores.pais %>" class="<%= inputClass %>" />
    </fieldset>

    <fieldset class="flex flex-col gap-3">
      <legend class="mb-2 text-sm font-semibold uppercase tracking-wide text-neutral-400">Metodo de envio</legend>
      <% metodosEnvio.forEach((m) => { %>
        <label class="flex items-center justify-between rounded-lg border border-neutral-700 bg-neutral-900 px-4 py-3 text-sm">
          <span class="flex items-center gap-3">
            <input type="radio" name="metodoEnvioId" value="<%= m.id %>" <%= String(m.id) === valores.metodoEnvioId ? 'checked' : '' %> required />
            <%= m.nombre %> <%= m.diasEstimados ? `(${m.diasEstimados} dias aprox.)` : '' %>
          </span>
          <span class="font-semibold"><%= Number(m.costoBase) === 0 ? 'Gratis' : formatCOP(m.costoBase) %></span>
        </label>
      <% }) %>
    </fieldset>

    <fieldset class="flex flex-col gap-3">
      <legend class="mb-2 text-sm font-semibold uppercase tracking-wide text-neutral-400">Metodo de pago</legend>
      <% metodosPago.forEach((m) => { %>
        <label class="flex items-center gap-3 rounded-lg border border-neutral-700 bg-neutral-900 px-4 py-3 text-sm">
          <input type="radio" name="metodoPago" value="<%= m.value %>" <%= m.value === valores.metodoPago ? 'checked' : '' %> required />
          <%= m.label %>
        </label>
      <% }) %>
    </fieldset>

    <div class="rounded-xl border border-neutral-800 bg-neutral-900 p-4">
      <div class="flex flex-col gap-2 text-sm text-neutral-300">
        <% items.forEach((item) => { %>
          <div class="flex items-center justify-between">
            <span><%= item.producto.nombre %> x<%= item.cantidad %></span>
            <span><%= formatCOP(item.subtotal) %></span>
          </div>
        <% }) %>
        <div class="flex items-center justify-between text-neutral-400">
          <span>Envio</span>
          <span><%= costoEnvio === 0 ? 'Gratis' : formatCOP(costoEnvio) %></span>
        </div>
      </div>
      <div class="mt-3 flex items-center justify-between border-t border-neutral-800 pt-3 font-semibold">
        <span>Total</span>
        <span><%= formatCOP(subtotal + costoEnvio) %></span>
      </div>
    </div>

    <button
      type="submit"
      <%= items.length === 0 ? 'disabled' : '' %>
      class="rounded-full bg-brand-500 px-6 py-3 font-semibold text-neutral-950 transition hover:bg-brand-400 disabled:cursor-not-allowed disabled:opacity-50"
    >Confirmar pedido</button>
  </form>
</div>

<%- include('../partials/layout-end') %>
