# Credenciales de Postgres / pgAdmin usadas por docker-compose.yml
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=ironfuel
PGADMIN_EMAIL=admin@ironfuel.com
PGADMIN_PASSWORD=admin123

# Cadena de conexion que usa Prisma (debe coincidir con las credenciales de arriba)
DATABASE_URL=postgresql://admin:admin123@localhost:5432/ironfuel

# Secreto usado para firmar la cookie de sesion del panel admin (genera uno largo y aleatorio en produccion)
SESSION_SECRET=change-this-to-a-long-random-string

# Cuenta de administrador que crea el seed la primera vez
ADMIN_EMAIL=admin@ironfuel.com
ADMIN_PASSWORD=admin123
