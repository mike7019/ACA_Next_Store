---
import '../styles/global.css';
import Sidebar from '../components/admin/Sidebar.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
const admin = Astro.locals.admin;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Admin IronFuel</title>
  </head>
  <body class="flex min-h-screen bg-neutral-900 text-neutral-100">
    <Sidebar />
    <div class="flex-1">
      <header class="flex items-center justify-between border-b border-neutral-800 bg-neutral-950 px-6 py-4">
        <h1 class="text-lg font-semibold">{title}</h1>
        {admin && <p class="text-sm text-neutral-400">{admin.nombre}</p>}
      </header>
      <div class="p-6">
        <slot />
      </div>
    </div>
  </body>
</html>
