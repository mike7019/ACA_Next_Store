---
import Layout from '../layouts/Layout.astro';
import { prisma } from '../lib/prisma';
import { Prisma } from '../generated/prisma/client.ts';

const metodosEnvio = await prisma.metodoEnvio.findMany({
  where: { activo: true },
  orderBy: { costoBase: 'asc' },
});

const metodosPago: { value: string; label: string }[] = [
  { value: 'tarjeta_credito', label: 'Tarjeta de credito' },
  { value: 'tarjeta_debito', label: 'Tarjeta de debito' },
  { value: 'transferencia', label: 'Transferencia bancaria' },
  { value: 'efectivo', label: 'Efectivo (pago contra entrega)' },
  { value: 'billetera_digital', label: 'Billetera digital' },
];

let error: string | null = null;
let pedidoId: number | null = null;

if (Astro.request.method === 'POST') {
  try {
    const form = await Astro.request.formData();

    const nombre = String(form.get('nombre') ?? '').trim();
    const apellido = String(form.get('apellido') ?? '').trim();
    const email = String(form.get('email') ?? '').trim().toLowerCase();
    const telefono = String(form.get('telefono') ?? '').trim();
    const calle = String(form.get('calle') ?? '').trim();
    const ciudad = String(form.get('ciudad') ?? '').trim();
    const departamento = String(form.get('departamento') ?? '').trim();
    const codigoPostal = String(form.get('codigoPostal') ?? '').trim();
    const pais = String(form.get('pais') ?? 'Colombia').trim();
    const metodoEnvioId = Number(form.get('metodoEnvioId'));
    const metodoPago = String(form.get('metodoPago') ?? '') as Prisma.PagoCreateInput['metodo'];
    const cartRaw = String(form.get('cart') ?? '[]');

    const cartItems = JSON.parse(cartRaw) as { productoId: number; cantidad: number }[];

    if (!nombre || !apellido || !email || !calle || !ciudad) {
      throw new Error('Completa todos los campos obligatorios.');
    }
    if (cartItems.length === 0) {
      throw new Error('Tu carrito esta vacio.');
    }

    const metodoEnvio = metodosEnvio.find((m) => m.id === metodoEnvioId);
    if (!metodoEnvio) {
      throw new Error('Selecciona un metodo de envio valido.');
    }

    const productos = await prisma.producto.findMany({
      where: { id: { in: cartItems.map((i) => i.productoId) }, activo: true },
    });

    if (productos.length !== cartItems.length) {
      throw new Error('Alguno de los productos de tu carrito ya no esta disponible.');
    }

    for (const item of cartItems) {
      const producto = productos.find((p) => p.id === item.productoId)!;
      if (item.cantidad < 1 || item.cantidad > producto.stock) {
        throw new Error(`No hay stock suficiente de "${producto.nombre}".`);
      }
    }

    const detalles = cartItems.map((item) => {
      const producto = productos.find((p) => p.id === item.productoId)!;
      const precioUnit = producto.precio;
      const subtotalLinea = precioUnit.times(item.cantidad);
      return { productoId: producto.id, cantidad: item.cantidad, precioUnit, subtotal: subtotalLinea };
    });

    const subtotal = detalles.reduce((sum, d) => sum.plus(d.subtotal), new Prisma.Decimal(0));
    const total = subtotal.plus(metodoEnvio.costoBase);

    const pedido = await prisma.$transaction(async (tx) => {
      const cliente = await tx.cliente.upsert({
        where: { email },
        update: { nombre, apellido, telefono: telefono || undefined },
        create: { nombre, apellido, email, telefono: telefono || null },
      });

      const direccion = await tx.direccionEnvio.create({
        data: {
          clienteId: cliente.id,
          alias: 'Envio',
          calle,
          ciudad,
          departamento: departamento || null,
          codigoPostal: codigoPostal || null,
          pais,
          esPrincipal: false,
        },
      });

      const nuevoPedido = await tx.pedido.create({
        data: {
          clienteId: cliente.id,
          direccionEnvioId: direccion.id,
          estado: 'pendiente',
          subtotal,
          costoEnvio: metodoEnvio.costoBase,
          total,
          detalles: { create: detalles },
          envio: {
            create: {
              metodoEnvioId: metodoEnvio.id,
              estado: 'preparando',
              fechaEntregaEst: metodoEnvio.diasEstimados
                ? new Date(Date.now() + metodoEnvio.diasEstimados * 24 * 60 * 60 * 1000)
                : null,
            },
          },
          pago: {
            create: {
              metodo: metodoPago,
              estado: 'pendiente',
              monto: total,
            },
          },
        },
      });

      for (const item of cartItems) {
        await tx.producto.update({
          where: { id: item.productoId },
          data: { stock: { decrement: item.cantidad } },
        });
      }

      return nuevoPedido;
    });

    pedidoId = pedido.id;
  } catch (err) {
    error = err instanceof Error ? err.message : 'No pudimos procesar tu pedido.';
  }
}

if (pedidoId) {
  return Astro.redirect(`/checkout/confirmacion/${pedidoId}`);
}
---

<Layout title="Checkout">
  <div class="mx-auto max-w-3xl px-4 py-10">
    <h1 class="mb-8 text-2xl font-bold">Finalizar compra</h1>

    <p id="cart-empty-warning" class="hidden mb-6 rounded-lg border border-yellow-700 bg-yellow-950/40 px-4 py-3 text-sm text-yellow-300">
      Tu carrito esta vacio. <a href="/productos" class="underline">Ver productos</a>
    </p>

    {error && (
      <p class="mb-6 rounded-lg border border-red-700 bg-red-950/40 px-4 py-3 text-sm text-red-300">{error}</p>
    )}

    <form method="POST" class="flex flex-col gap-6">
      <input type="hidden" name="cart" id="cart-field" value="[]" />

      <fieldset class="grid gap-4 sm:grid-cols-2">
        <legend class="mb-2 text-sm font-semibold uppercase tracking-wide text-neutral-400">Datos de contacto</legend>
        <input name="nombre" required placeholder="Nombre" class="rounded-lg border border-neutral-700 bg-neutral-900 px-4 py-2" />
        <input name="apellido" required placeholder="Apellido" class="rounded-lg border border-neutral-700 bg-neutral-900 px-4 py-2" />
        <input name="email" type="email" required placeholder="Correo electronico" class="rounded-lg border border-neutral-700 bg-neutral-900 px-4 py-2 sm:col-span-2" />
        <input name="telefono" placeholder="Telefono" class="rounded-lg border border-neutral-700 bg-neutral-900 px-4 py-2 sm:col-span-2" />
      </fieldset>

      <fieldset class="grid gap-4 sm:grid-cols-2">
        <legend class="mb-2 text-sm font-semibold uppercase tracking-wide text-neutral-400">Direccion de envio</legend>
        <input name="calle" required placeholder="Calle / direccion" class="rounded-lg border border-neutral-700 bg-neutral-900 px-4 py-2 sm:col-span-2" />
        <input name="ciudad" required placeholder="Ciudad" class="rounded-lg border border-neutral-700 bg-neutral-900 px-4 py-2" />
        <input name="departamento" placeholder="Departamento" class="rounded-lg border border-neutral-700 bg-neutral-900 px-4 py-2" />
        <input name="codigoPostal" placeholder="Codigo postal" class="rounded-lg border border-neutral-700 bg-neutral-900 px-4 py-2" />
        <input name="pais" value="Colombia" placeholder="Pais" class="rounded-lg border border-neutral-700 bg-neutral-900 px-4 py-2" />
      </fieldset>

      <fieldset class="flex flex-col gap-3">
        <legend class="mb-2 text-sm font-semibold uppercase tracking-wide text-neutral-400">Metodo de envio</legend>
        {metodosEnvio.map((m) => (
          <label class="flex items-center justify-between rounded-lg border border-neutral-700 bg-neutral-900 px-4 py-3 text-sm">
            <span class="flex items-center gap-3">
              <input type="radio" name="metodoEnvioId" value={m.id} data-costo={String(m.costoBase)} required />
              {m.nombre} {m.diasEstimados ? `(${m.diasEstimados} dias aprox.)` : ''}
            </span>
            <span class="font-semibold">
              {Number(m.costoBase) === 0 ? 'Gratis' : new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 }).format(Number(m.costoBase))}
            </span>
          </label>
        ))}
      </fieldset>

      <fieldset class="flex flex-col gap-3">
        <legend class="mb-2 text-sm font-semibold uppercase tracking-wide text-neutral-400">Metodo de pago</legend>
        {metodosPago.map((m) => (
          <label class="flex items-center gap-3 rounded-lg border border-neutral-700 bg-neutral-900 px-4 py-3 text-sm">
            <input type="radio" name="metodoPago" value={m.value} required />
            {m.label}
          </label>
        ))}
      </fieldset>

      <div class="rounded-xl border border-neutral-800 bg-neutral-900 p-4">
        <div id="checkout-summary" class="flex flex-col gap-2 text-sm text-neutral-300"></div>
        <div class="mt-3 flex items-center justify-between border-t border-neutral-800 pt-3 font-semibold">
          <span>Total</span>
          <span id="checkout-total"></span>
        </div>
      </div>

      <button
        id="checkout-submit"
        type="submit"
        class="rounded-full bg-brand-500 px-6 py-3 font-semibold text-neutral-950 transition hover:bg-brand-400"
      >
        Confirmar pedido
      </button>
    </form>
  </div>
</Layout>

<script>
  import { getCart } from '../lib/cart-client';
  import { formatCOP } from '../lib/format';

  const items = getCart();
  const cartField = document.getElementById('cart-field') as HTMLInputElement;
  const summaryEl = document.getElementById('checkout-summary')!;
  const totalEl = document.getElementById('checkout-total')!;
  const submitBtn = document.getElementById('checkout-submit') as HTMLButtonElement;
  const emptyWarning = document.getElementById('cart-empty-warning')!;

  if (items.length === 0) {
    emptyWarning.classList.remove('hidden');
    submitBtn.disabled = true;
    submitBtn.classList.add('cursor-not-allowed', 'opacity-50');
  }

  cartField.value = JSON.stringify(items.map((i) => ({ productoId: i.productoId, cantidad: i.cantidad })));

  summaryEl.replaceChildren(
    ...items.map((item) => {
      const row = document.createElement('div');
      row.className = 'flex items-center justify-between';
      const label = document.createElement('span');
      label.textContent = `${item.nombre} x${item.cantidad}`;
      const price = document.createElement('span');
      price.textContent = formatCOP(item.precio * item.cantidad);
      row.append(label, price);
      return row;
    }),
  );

  const subtotal = items.reduce((sum, i) => sum + i.precio * i.cantidad, 0);

  function updateTotal() {
    const selected = document.querySelector<HTMLInputElement>('input[name="metodoEnvioId"]:checked');
    const costoEnvio = selected ? Number(selected.dataset.costo ?? 0) : 0;
    totalEl.textContent = formatCOP(subtotal + costoEnvio);
  }

  document.querySelectorAll<HTMLInputElement>('input[name="metodoEnvioId"]').forEach((input) => {
    input.addEventListener('change', updateTotal);
  });

  updateTotal();
</script>
