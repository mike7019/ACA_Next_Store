---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { slugify } from '../../../lib/format';
import { prisma } from '../../../lib/prisma';

let error: string | null =
  Astro.url.searchParams.get('error') === 'tiene-productos'
    ? 'No se puede eliminar: esta categoria todavia tiene productos asociados.'
    : null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const nombre = String(form.get('nombre') ?? '').trim();
  const descripcion = String(form.get('descripcion') ?? '').trim();

  if (!nombre) {
    error = 'El nombre es obligatorio.';
  } else {
    let slug = slugify(nombre);
    const existente = await prisma.categoria.findUnique({ where: { slug } });
    if (existente) slug = `${slug}-${Date.now().toString(36)}`;

    try {
      await prisma.categoria.create({ data: { nombre, slug, descripcion: descripcion || null } });
      return Astro.redirect('/admin/categorias');
    } catch {
      error = 'Ya existe una categoria con ese nombre.';
    }
  }
}

const categorias = await prisma.categoria.findMany({
  orderBy: { nombre: 'asc' },
  include: { _count: { select: { productos: true } } },
});
---

<AdminLayout title="Categorias">
  {error && <p class="mb-4 rounded-lg border border-red-700 bg-red-950/40 px-4 py-3 text-sm text-red-300">{error}</p>}

  <form method="POST" class="mb-8 flex flex-col gap-3 rounded-xl border border-neutral-800 bg-neutral-950 p-5 sm:flex-row sm:items-end">
    <label class="flex flex-1 flex-col gap-1 text-sm">
      Nombre
      <input name="nombre" required placeholder="ej. Pre-entrenos" class="rounded-lg border border-neutral-700 bg-neutral-900 px-4 py-2" />
    </label>
    <label class="flex flex-1 flex-col gap-1 text-sm">
      Descripcion
      <input name="descripcion" placeholder="Opcional" class="rounded-lg border border-neutral-700 bg-neutral-900 px-4 py-2" />
    </label>
    <button type="submit" class="whitespace-nowrap rounded-lg bg-brand-500 px-5 py-2 font-semibold text-neutral-950 hover:bg-brand-400">
      + Agregar
    </button>
  </form>

  <div class="overflow-x-auto rounded-xl border border-neutral-800 bg-neutral-950">
    <table class="w-full text-sm">
      <thead class="text-left text-neutral-500">
        <tr>
          <th class="px-5 py-3 font-medium">Nombre</th>
          <th class="px-5 py-3 font-medium">Descripcion</th>
          <th class="px-5 py-3 font-medium text-right">Productos</th>
          <th class="px-5 py-3 font-medium"></th>
        </tr>
      </thead>
      <tbody>
        {categorias.map((c) => (
          <tr class="border-t border-neutral-800">
            <td class="px-5 py-3 font-medium">{c.nombre}</td>
            <td class="px-5 py-3 text-neutral-400">{c.descripcion}</td>
            <td class="px-5 py-3 text-right">{c._count.productos}</td>
            <td class="px-5 py-3 text-right">
              <div class="flex justify-end gap-3">
                <a href={`/admin/categorias/${c.id}/editar`} class="text-brand-500 hover:text-brand-400">Editar</a>
                <form method="POST" action={`/admin/categorias/${c.id}/eliminar`} onsubmit="return confirm('¿Eliminar esta categoria?')">
                  <button type="submit" class="text-red-400 hover:text-red-300">Eliminar</button>
                </form>
              </div>
            </td>
          </tr>
        ))}
        {categorias.length === 0 && (
          <tr><td colspan="4" class="px-5 py-6 text-center text-neutral-500">No hay categorias.</td></tr>
        )}
      </tbody>
    </table>
  </div>
</AdminLayout>
