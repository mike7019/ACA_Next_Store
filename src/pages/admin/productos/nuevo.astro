---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { slugify } from '../../../lib/format';
import { prisma } from '../../../lib/prisma';

const categorias = await prisma.categoria.findMany({ orderBy: { nombre: 'asc' } });
let error: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();

  const nombre = String(form.get('nombre') ?? '').trim();
  const categoriaId = Number(form.get('categoriaId'));
  const descripcion = String(form.get('descripcion') ?? '').trim();
  const marca = String(form.get('marca') ?? '').trim();
  const sabor = String(form.get('sabor') ?? '').trim();
  const presentacion = String(form.get('presentacion') ?? '').trim();
  const precio = Number(form.get('precio'));
  const stock = Number(form.get('stock'));
  const imagenUrl = String(form.get('imagenUrl') ?? '').trim();
  const destacado = form.get('destacado') === 'on';
  const activo = form.get('activo') === 'on';

  if (!nombre || !categoriaId || Number.isNaN(precio) || precio < 0) {
    error = 'Revisa el nombre, la categoria y el precio.';
  } else {
    let slug = slugify(nombre);
    const existente = await prisma.producto.findUnique({ where: { slug } });
    if (existente) slug = `${slug}-${Date.now().toString(36)}`;

    await prisma.producto.create({
      data: {
        nombre,
        slug,
        categoriaId,
        descripcion: descripcion || null,
        marca: marca || null,
        sabor: sabor || null,
        presentacion: presentacion || null,
        precio,
        stock: Number.isNaN(stock) ? 0 : stock,
        imagenUrl: imagenUrl || null,
        destacado,
        activo,
      },
    });

    return Astro.redirect('/admin/productos');
  }
}
---

<AdminLayout title="Nuevo producto">
  {error && <p class="mb-4 rounded-lg border border-red-700 bg-red-950/40 px-4 py-3 text-sm text-red-300">{error}</p>}

  <form method="POST" class="grid max-w-2xl gap-4">
    <label class="flex flex-col gap-1 text-sm">
      Nombre
      <input name="nombre" required class="rounded-lg border border-neutral-700 bg-neutral-950 px-4 py-2" />
    </label>

    <label class="flex flex-col gap-1 text-sm">
      Categoria
      <select name="categoriaId" required class="rounded-lg border border-neutral-700 bg-neutral-950 px-4 py-2">
        <option value="">Selecciona una categoria</option>
        {categorias.map((c) => <option value={c.id}>{c.nombre}</option>)}
      </select>
    </label>

    <label class="flex flex-col gap-1 text-sm">
      Descripcion
      <textarea name="descripcion" rows="4" class="rounded-lg border border-neutral-700 bg-neutral-950 px-4 py-2"></textarea>
    </label>

    <div class="grid grid-cols-2 gap-4">
      <label class="flex flex-col gap-1 text-sm">
        Marca
        <input name="marca" class="rounded-lg border border-neutral-700 bg-neutral-950 px-4 py-2" />
      </label>
      <label class="flex flex-col gap-1 text-sm">
        Sabor
        <input name="sabor" class="rounded-lg border border-neutral-700 bg-neutral-950 px-4 py-2" />
      </label>
      <label class="flex flex-col gap-1 text-sm">
        Presentacion
        <input name="presentacion" placeholder="ej. 1 kg, 60 caps" class="rounded-lg border border-neutral-700 bg-neutral-950 px-4 py-2" />
      </label>
      <label class="flex flex-col gap-1 text-sm">
        URL de imagen
        <input name="imagenUrl" class="rounded-lg border border-neutral-700 bg-neutral-950 px-4 py-2" />
      </label>
      <label class="flex flex-col gap-1 text-sm">
        Precio (COP)
        <input name="precio" type="number" min="0" step="100" required class="rounded-lg border border-neutral-700 bg-neutral-950 px-4 py-2" />
      </label>
      <label class="flex flex-col gap-1 text-sm">
        Stock
        <input name="stock" type="number" min="0" value="0" class="rounded-lg border border-neutral-700 bg-neutral-950 px-4 py-2" />
      </label>
    </div>

    <div class="flex gap-6 text-sm">
      <label class="flex items-center gap-2">
        <input type="checkbox" name="activo" checked /> Activo
      </label>
      <label class="flex items-center gap-2">
        <input type="checkbox" name="destacado" /> Destacado en home
      </label>
    </div>

    <div class="flex gap-3">
      <button type="submit" class="rounded-lg bg-brand-500 px-5 py-2 font-semibold text-neutral-950 hover:bg-brand-400">
        Guardar producto
      </button>
      <a href="/admin/productos" class="rounded-lg border border-neutral-700 px-5 py-2 hover:border-neutral-500">
        Cancelar
      </a>
    </div>
  </form>
</AdminLayout>
