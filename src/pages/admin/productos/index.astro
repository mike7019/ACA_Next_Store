---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { formatCOP } from '../../../lib/format';
import { prisma } from '../../../lib/prisma';

const buscar = Astro.url.searchParams.get('buscar')?.trim() ?? '';

const productos = await prisma.producto.findMany({
  where: buscar
    ? {
        OR: [
          { nombre: { contains: buscar, mode: 'insensitive' } },
          { marca: { contains: buscar, mode: 'insensitive' } },
        ],
      }
    : undefined,
  include: { categoria: true },
  orderBy: { creadoEn: 'desc' },
});
---

<AdminLayout title="Productos">
  <div class="mb-6 flex items-center justify-between gap-4">
    <form method="GET" class="flex-1">
      <input
        type="search"
        name="buscar"
        value={buscar}
        placeholder="Buscar por nombre o marca..."
        class="w-full max-w-sm rounded-lg border border-neutral-700 bg-neutral-950 px-4 py-2 text-sm focus:border-brand-500 focus:outline-none"
      />
    </form>
    <a href="/admin/productos/nuevo" class="whitespace-nowrap rounded-lg bg-brand-500 px-4 py-2 text-sm font-semibold text-neutral-950 hover:bg-brand-400">
      + Nuevo producto
    </a>
  </div>

  <div class="overflow-x-auto rounded-xl border border-neutral-800 bg-neutral-950">
    <table class="w-full text-sm">
      <thead class="text-left text-neutral-500">
        <tr>
          <th class="px-5 py-3 font-medium">Producto</th>
          <th class="px-5 py-3 font-medium">Categoria</th>
          <th class="px-5 py-3 font-medium text-right">Precio</th>
          <th class="px-5 py-3 font-medium text-right">Stock</th>
          <th class="px-5 py-3 font-medium">Estado</th>
          <th class="px-5 py-3 font-medium"></th>
        </tr>
      </thead>
      <tbody>
        {productos.map((p) => (
          <tr class="border-t border-neutral-800">
            <td class="px-5 py-3">
              <p class="font-medium">{p.nombre}</p>
              {p.marca && <p class="text-xs text-neutral-500">{p.marca}</p>}
            </td>
            <td class="px-5 py-3 text-neutral-400">{p.categoria.nombre}</td>
            <td class="px-5 py-3 text-right">{formatCOP(p.precio)}</td>
            <td class="px-5 py-3 text-right">{p.stock}</td>
            <td class="px-5 py-3">
              <span class:list={['rounded-full px-2 py-0.5 text-xs font-semibold', p.activo ? 'bg-emerald-950 text-emerald-400' : 'bg-neutral-800 text-neutral-500']}>
                {p.activo ? 'Activo' : 'Inactivo'}
              </span>
            </td>
            <td class="px-5 py-3 text-right">
              <div class="flex justify-end gap-3">
                <a href={`/admin/productos/${p.id}/editar`} class="text-brand-500 hover:text-brand-400">Editar</a>
                <form method="POST" action={`/admin/productos/${p.id}/eliminar`} onsubmit="return confirm('¿Eliminar este producto?')">
                  <button type="submit" class="text-red-400 hover:text-red-300">Eliminar</button>
                </form>
              </div>
            </td>
          </tr>
        ))}
        {productos.length === 0 && (
          <tr><td colspan="6" class="px-5 py-6 text-center text-neutral-500">No hay productos.</td></tr>
        )}
      </tbody>
    </table>
  </div>
</AdminLayout>
