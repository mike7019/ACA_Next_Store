---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { prisma } from '../../../../lib/prisma';

const id = Number(Astro.params.id);
const categorias = await prisma.categoria.findMany({ orderBy: { nombre: 'asc' } });

let producto = await prisma.producto.findUnique({ where: { id } });
if (!producto) {
  return Astro.redirect('/admin/productos');
}

let error: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();

  const nombre = String(form.get('nombre') ?? '').trim();
  const categoriaId = Number(form.get('categoriaId'));
  const descripcion = String(form.get('descripcion') ?? '').trim();
  const marca = String(form.get('marca') ?? '').trim();
  const sabor = String(form.get('sabor') ?? '').trim();
  const presentacion = String(form.get('presentacion') ?? '').trim();
  const precio = Number(form.get('precio'));
  const stock = Number(form.get('stock'));
  const imagenUrl = String(form.get('imagenUrl') ?? '').trim();
  const destacado = form.get('destacado') === 'on';
  const activo = form.get('activo') === 'on';

  if (!nombre || !categoriaId || Number.isNaN(precio) || precio < 0) {
    error = 'Revisa el nombre, la categoria y el precio.';
  } else {
    producto = await prisma.producto.update({
      where: { id },
      data: {
        nombre,
        categoriaId,
        descripcion: descripcion || null,
        marca: marca || null,
        sabor: sabor || null,
        presentacion: presentacion || null,
        precio,
        stock: Number.isNaN(stock) ? 0 : stock,
        imagenUrl: imagenUrl || null,
        destacado,
        activo,
      },
    });

    return Astro.redirect('/admin/productos');
  }
}
---

<AdminLayout title={`Editar: ${producto.nombre}`}>
  {error && <p class="mb-4 rounded-lg border border-red-700 bg-red-950/40 px-4 py-3 text-sm text-red-300">{error}</p>}

  <form method="POST" class="grid max-w-2xl gap-4">
    <label class="flex flex-col gap-1 text-sm">
      Nombre
      <input name="nombre" required value={producto.nombre} class="rounded-lg border border-neutral-700 bg-neutral-950 px-4 py-2" />
    </label>

    <label class="flex flex-col gap-1 text-sm">
      Categoria
      <select name="categoriaId" required class="rounded-lg border border-neutral-700 bg-neutral-950 px-4 py-2">
        {categorias.map((c) => (
          <option value={c.id} selected={c.id === producto.categoriaId}>{c.nombre}</option>
        ))}
      </select>
    </label>

    <label class="flex flex-col gap-1 text-sm">
      Descripcion
      <textarea name="descripcion" rows="4" class="rounded-lg border border-neutral-700 bg-neutral-950 px-4 py-2">{producto.descripcion}</textarea>
    </label>

    <div class="grid grid-cols-2 gap-4">
      <label class="flex flex-col gap-1 text-sm">
        Marca
        <input name="marca" value={producto.marca ?? ''} class="rounded-lg border border-neutral-700 bg-neutral-950 px-4 py-2" />
      </label>
      <label class="flex flex-col gap-1 text-sm">
        Sabor
        <input name="sabor" value={producto.sabor ?? ''} class="rounded-lg border border-neutral-700 bg-neutral-950 px-4 py-2" />
      </label>
      <label class="flex flex-col gap-1 text-sm">
        Presentacion
        <input name="presentacion" value={producto.presentacion ?? ''} class="rounded-lg border border-neutral-700 bg-neutral-950 px-4 py-2" />
      </label>
      <label class="flex flex-col gap-1 text-sm">
        URL de imagen
        <input name="imagenUrl" value={producto.imagenUrl ?? ''} class="rounded-lg border border-neutral-700 bg-neutral-950 px-4 py-2" />
      </label>
      <label class="flex flex-col gap-1 text-sm">
        Precio (COP)
        <input name="precio" type="number" min="0" step="100" required value={producto.precio.toString()} class="rounded-lg border border-neutral-700 bg-neutral-950 px-4 py-2" />
      </label>
      <label class="flex flex-col gap-1 text-sm">
        Stock
        <input name="stock" type="number" min="0" value={producto.stock} class="rounded-lg border border-neutral-700 bg-neutral-950 px-4 py-2" />
      </label>
    </div>

    <div class="flex gap-6 text-sm">
      <label class="flex items-center gap-2">
        <input type="checkbox" name="activo" checked={producto.activo} /> Activo
      </label>
      <label class="flex items-center gap-2">
        <input type="checkbox" name="destacado" checked={producto.destacado} /> Destacado en home
      </label>
    </div>

    <div class="flex gap-3">
      <button type="submit" class="rounded-lg bg-brand-500 px-5 py-2 font-semibold text-neutral-950 hover:bg-brand-400">
        Guardar cambios
      </button>
      <a href="/admin/productos" class="rounded-lg border border-neutral-700 px-5 py-2 hover:border-neutral-500">
        Cancelar
      </a>
    </div>
  </form>
</AdminLayout>
