---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { formatCOP } from '../../../lib/format';
import { prisma } from '../../../lib/prisma';

const id = Number(Astro.params.id);

async function cargarPedido() {
  return prisma.pedido.findUnique({
    where: { id },
    include: {
      cliente: true,
      direccionEnvio: true,
      detalles: { include: { producto: true } },
      envio: { include: { metodoEnvio: true } },
      pago: true,
    },
  });
}

let pedido = await cargarPedido();
if (!pedido) {
  return Astro.redirect('/admin/pedidos');
}

let error: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const accion = String(form.get('accion') ?? '');

  try {
    if (accion === 'estado_pedido') {
      await prisma.pedido.update({
        where: { id },
        data: { estado: String(form.get('estado')) as never },
      });
    } else if (accion === 'envio' && pedido.envio) {
      await prisma.envio.update({
        where: { pedidoId: id },
        data: {
          estado: String(form.get('estadoEnvio')) as never,
          numeroGuia: String(form.get('numeroGuia') ?? '').trim() || null,
        },
      });
    } else if (accion === 'pago' && pedido.pago) {
      await prisma.pago.update({
        where: { pedidoId: id },
        data: { estado: String(form.get('estadoPago')) as never },
      });
    }
    pedido = await cargarPedido();
  } catch {
    error = 'No pudimos guardar el cambio.';
  }
}

const estadosPedido = ['pendiente', 'confirmado', 'en_preparacion', 'enviado', 'entregado', 'cancelado'];
const estadosEnvio = ['preparando', 'despachado', 'en_transito', 'entregado', 'devuelto'];
const estadosPago = ['pendiente', 'aprobado', 'rechazado', 'reembolsado'];
---

<AdminLayout title={`Pedido #${pedido!.id}`}>
  {error && <p class="mb-4 rounded-lg border border-red-700 bg-red-950/40 px-4 py-3 text-sm text-red-300">{error}</p>}

  <div class="grid gap-6 lg:grid-cols-3">
    <div class="lg:col-span-2">
      <div class="rounded-xl border border-neutral-800 bg-neutral-950 p-5">
        <h2 class="mb-4 font-semibold">Productos</h2>
        <div class="flex flex-col divide-y divide-neutral-800">
          {pedido!.detalles.map((d) => (
            <div class="flex items-center justify-between py-3 text-sm">
              <div>
                <p class="font-medium">{d.producto.nombre}</p>
                <p class="text-neutral-500">{d.cantidad} x {formatCOP(d.precioUnit)}</p>
              </div>
              <p class="font-semibold">{formatCOP(d.subtotal)}</p>
            </div>
          ))}
        </div>
        <div class="mt-4 flex flex-col gap-1 border-t border-neutral-800 pt-4 text-sm text-neutral-400">
          <div class="flex justify-between"><span>Subtotal</span><span>{formatCOP(pedido!.subtotal)}</span></div>
          <div class="flex justify-between"><span>Envio</span><span>{formatCOP(pedido!.costoEnvio)}</span></div>
          <div class="flex justify-between text-base font-bold text-neutral-100"><span>Total</span><span>{formatCOP(pedido!.total)}</span></div>
        </div>
      </div>

      <div class="mt-6 rounded-xl border border-neutral-800 bg-neutral-950 p-5">
        <h2 class="mb-4 font-semibold">Cliente y direccion</h2>
        <p class="text-sm">{pedido!.cliente.nombre} {pedido!.cliente.apellido}</p>
        <p class="text-sm text-neutral-400">{pedido!.cliente.email} {pedido!.cliente.telefono ? `· ${pedido!.cliente.telefono}` : ''}</p>
        {pedido!.direccionEnvio && (
          <p class="mt-2 text-sm text-neutral-400">
            {pedido!.direccionEnvio.calle}, {pedido!.direccionEnvio.ciudad}
            {pedido!.direccionEnvio.departamento ? `, ${pedido!.direccionEnvio.departamento}` : ''}
          </p>
        )}
      </div>
    </div>

    <div class="flex flex-col gap-6">
      <form method="POST" class="rounded-xl border border-neutral-800 bg-neutral-950 p-5">
        <input type="hidden" name="accion" value="estado_pedido" />
        <h2 class="mb-3 font-semibold">Estado del pedido</h2>
        <select name="estado" class="mb-3 w-full rounded-lg border border-neutral-700 bg-neutral-900 px-3 py-2 text-sm capitalize">
          {estadosPedido.map((e) => <option value={e} selected={e === pedido!.estado}>{e.replace('_', ' ')}</option>)}
        </select>
        <button type="submit" class="w-full rounded-lg bg-brand-500 px-3 py-2 text-sm font-semibold text-neutral-950 hover:bg-brand-400">
          Actualizar
        </button>
      </form>

      {pedido!.envio && (
        <form method="POST" class="rounded-xl border border-neutral-800 bg-neutral-950 p-5">
          <input type="hidden" name="accion" value="envio" />
          <h2 class="mb-3 font-semibold">Envio ({pedido!.envio.metodoEnvio.nombre})</h2>
          <select name="estadoEnvio" class="mb-3 w-full rounded-lg border border-neutral-700 bg-neutral-900 px-3 py-2 text-sm capitalize">
            {estadosEnvio.map((e) => <option value={e} selected={e === pedido!.envio!.estado}>{e.replace('_', ' ')}</option>)}
          </select>
          <input
            name="numeroGuia"
            placeholder="Numero de guia"
            value={pedido!.envio.numeroGuia ?? ''}
            class="mb-3 w-full rounded-lg border border-neutral-700 bg-neutral-900 px-3 py-2 text-sm"
          />
          <button type="submit" class="w-full rounded-lg bg-brand-500 px-3 py-2 text-sm font-semibold text-neutral-950 hover:bg-brand-400">
            Actualizar
          </button>
        </form>
      )}

      {pedido!.pago && (
        <form method="POST" class="rounded-xl border border-neutral-800 bg-neutral-950 p-5">
          <input type="hidden" name="accion" value="pago" />
          <h2 class="mb-3 font-semibold">Pago ({pedido!.pago.metodo.replace('_', ' ')})</h2>
          <select name="estadoPago" class="mb-3 w-full rounded-lg border border-neutral-700 bg-neutral-900 px-3 py-2 text-sm capitalize">
            {estadosPago.map((e) => <option value={e} selected={e === pedido!.pago!.estado}>{e}</option>)}
          </select>
          <button type="submit" class="w-full rounded-lg bg-brand-500 px-3 py-2 text-sm font-semibold text-neutral-950 hover:bg-brand-400">
            Actualizar
          </button>
        </form>
      )}
    </div>
  </div>
</AdminLayout>
