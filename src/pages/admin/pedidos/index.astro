---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { formatCOP } from '../../../lib/format';
import { prisma } from '../../../lib/prisma';

const estados = ['pendiente', 'confirmado', 'en_preparacion', 'enviado', 'entregado', 'cancelado'] as const;
const estadoFiltro = Astro.url.searchParams.get('estado') ?? '';

const pedidos = await prisma.pedido.findMany({
  where: estados.includes(estadoFiltro as (typeof estados)[number]) ? { estado: estadoFiltro as (typeof estados)[number] } : undefined,
  include: { cliente: true },
  orderBy: { creadoEn: 'desc' },
});
---

<AdminLayout title="Pedidos">
  <div class="mb-6 flex flex-wrap gap-2">
    <a
      href="/admin/pedidos"
      class:list={['rounded-full border px-4 py-1.5 text-sm font-medium', !estadoFiltro ? 'border-brand-500 bg-brand-500 text-neutral-950' : 'border-neutral-700 text-neutral-300 hover:border-neutral-500']}
    >
      Todos
    </a>
    {estados.map((e) => (
      <a
        href={`/admin/pedidos?estado=${e}`}
        class:list={['rounded-full border px-4 py-1.5 text-sm font-medium capitalize', estadoFiltro === e ? 'border-brand-500 bg-brand-500 text-neutral-950' : 'border-neutral-700 text-neutral-300 hover:border-neutral-500']}
      >
        {e.replace('_', ' ')}
      </a>
    ))}
  </div>

  <div class="overflow-x-auto rounded-xl border border-neutral-800 bg-neutral-950">
    <table class="w-full text-sm">
      <thead class="text-left text-neutral-500">
        <tr>
          <th class="px-5 py-3 font-medium">#</th>
          <th class="px-5 py-3 font-medium">Cliente</th>
          <th class="px-5 py-3 font-medium">Fecha</th>
          <th class="px-5 py-3 font-medium">Estado</th>
          <th class="px-5 py-3 font-medium text-right">Total</th>
        </tr>
      </thead>
      <tbody>
        {pedidos.map((p) => (
          <tr class="border-t border-neutral-800">
            <td class="px-5 py-3">
              <a href={`/admin/pedidos/${p.id}`} class="text-brand-500 hover:text-brand-400">#{p.id}</a>
            </td>
            <td class="px-5 py-3">{p.cliente.nombre} {p.cliente.apellido}</td>
            <td class="px-5 py-3 text-neutral-400">{p.creadoEn.toLocaleDateString('es-CO')}</td>
            <td class="px-5 py-3 capitalize">{p.estado.replace('_', ' ')}</td>
            <td class="px-5 py-3 text-right font-semibold">{formatCOP(p.total)}</td>
          </tr>
        ))}
        {pedidos.length === 0 && (
          <tr><td colspan="5" class="px-5 py-6 text-center text-neutral-500">No hay pedidos con este filtro.</td></tr>
        )}
      </tbody>
    </table>
  </div>
</AdminLayout>
