---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { prisma } from '../../lib/prisma';

const categoriaSlug = Astro.url.searchParams.get('categoria') ?? '';
const buscar = Astro.url.searchParams.get('buscar')?.trim() ?? '';

const categorias = await prisma.categoria.findMany({ orderBy: { nombre: 'asc' } });
const categoriaActiva = categorias.find((c) => c.slug === categoriaSlug);

const productos = await prisma.producto.findMany({
  where: {
    activo: true,
    ...(categoriaActiva ? { categoriaId: categoriaActiva.id } : {}),
    ...(buscar
      ? {
          OR: [
            { nombre: { contains: buscar, mode: 'insensitive' } },
            { marca: { contains: buscar, mode: 'insensitive' } },
            { descripcion: { contains: buscar, mode: 'insensitive' } },
          ],
        }
      : {}),
  },
  orderBy: { nombre: 'asc' },
});
---

<Layout title={categoriaActiva ? categoriaActiva.nombre : 'Productos'}>
  <div class="mx-auto max-w-6xl px-4 py-10">
    <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <h1 class="text-2xl font-bold">{categoriaActiva ? categoriaActiva.nombre : 'Todos los productos'}</h1>
      <form class="flex gap-2" method="GET" action="/productos">
        {categoriaActiva && <input type="hidden" name="categoria" value={categoriaActiva.slug} />}
        <input
          type="search"
          name="buscar"
          value={buscar}
          placeholder="Buscar productos..."
          class="w-full rounded-full border border-neutral-700 bg-neutral-900 px-4 py-2 text-sm focus:border-brand-500 focus:outline-none sm:w-64"
        />
      </form>
    </div>

    <div class="mb-8 flex flex-wrap gap-2">
      <a
        href="/productos"
        class:list={[
          'rounded-full border px-4 py-1.5 text-sm font-medium',
          !categoriaActiva ? 'border-brand-500 bg-brand-500 text-neutral-950' : 'border-neutral-700 text-neutral-300 hover:border-neutral-500',
        ]}
      >
        Todas
      </a>
      {categorias.map((c) => (
        <a
          href={`/productos?categoria=${c.slug}`}
          class:list={[
            'rounded-full border px-4 py-1.5 text-sm font-medium',
            categoriaActiva?.id === c.id ? 'border-brand-500 bg-brand-500 text-neutral-950' : 'border-neutral-700 text-neutral-300 hover:border-neutral-500',
          ]}
        >
          {c.nombre}
        </a>
      ))}
    </div>

    {productos.length === 0 ? (
      <p class="text-neutral-400">No encontramos productos con esos filtros.</p>
    ) : (
      <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
        {productos.map((producto) => <ProductCard producto={producto} />)}
      </div>
    )}
  </div>
</Layout>
