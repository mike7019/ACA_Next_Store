---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { formatCOP } from '../../lib/format';
import { prisma } from '../../lib/prisma';

const { slug } = Astro.params;

const producto = await prisma.producto.findUnique({
  where: { slug },
  include: { categoria: true },
});

if (!producto || !producto.activo) {
  return Astro.redirect('/productos');
}

const relacionados = await prisma.producto.findMany({
  where: {
    activo: true,
    categoriaId: producto.categoriaId,
    id: { not: producto.id },
  },
  take: 4,
});
---

<Layout title={producto.nombre} description={producto.descripcion ?? undefined}>
  <div class="mx-auto max-w-6xl px-4 py-10">
    <nav class="mb-6 text-sm text-neutral-500">
      <a href="/productos" class="hover:text-brand-400">Productos</a>
      <span class="mx-2">/</span>
      <a href={`/productos?categoria=${producto.categoria.slug}`} class="hover:text-brand-400">{producto.categoria.nombre}</a>
    </nav>

    <div class="grid gap-10 md:grid-cols-2">
      <div class="aspect-square overflow-hidden rounded-2xl border border-neutral-800 bg-neutral-900">
        {producto.imagenUrl ? (
          <img src={producto.imagenUrl} alt={producto.nombre} class="h-full w-full object-cover" />
        ) : (
          <div class="flex h-full w-full items-center justify-center text-neutral-600">Sin imagen</div>
        )}
      </div>

      <div class="flex flex-col gap-4">
        {producto.marca && <p class="text-sm font-semibold uppercase tracking-wide text-brand-500">{producto.marca}</p>}
        <h1 class="text-3xl font-bold">{producto.nombre}</h1>

        <div class="flex flex-wrap gap-2 text-sm text-neutral-400">
          {producto.presentacion && <span class="rounded-full border border-neutral-700 px-3 py-1">{producto.presentacion}</span>}
          {producto.sabor && <span class="rounded-full border border-neutral-700 px-3 py-1">Sabor: {producto.sabor}</span>}
        </div>

        <p class="text-3xl font-black">{formatCOP(producto.precio)}</p>

        <p class="whitespace-pre-line text-neutral-300">{producto.descripcion}</p>

        <p class="text-sm text-neutral-500">
          {producto.stock > 0 ? `${producto.stock} unidades disponibles` : 'Producto agotado'}
        </p>

        <div class="mt-4 flex items-center gap-3">
          <input
            id="cantidad"
            type="number"
            min="1"
            max={producto.stock}
            value="1"
            class="w-20 rounded-lg border border-neutral-700 bg-neutral-900 px-3 py-2 text-center"
            disabled={producto.stock <= 0}
          />
          <button
            id="add-to-cart-detail"
            data-id={producto.id}
            data-nombre={producto.nombre}
            data-slug={producto.slug}
            data-precio={String(producto.precio)}
            data-imagen={producto.imagenUrl ?? ''}
            disabled={producto.stock <= 0}
            class="flex-1 rounded-full bg-brand-500 px-6 py-3 font-semibold text-neutral-950 transition hover:bg-brand-400 disabled:cursor-not-allowed disabled:bg-neutral-700 disabled:text-neutral-400"
          >
            {producto.stock > 0 ? 'Agregar al carrito' : 'Agotado'}
          </button>
        </div>
      </div>
    </div>

    {relacionados.length > 0 && (
      <section class="mt-16">
        <h2 class="mb-6 text-xl font-bold">Tambien te puede interesar</h2>
        <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
          {relacionados.map((r) => <ProductCard producto={r} />)}
        </div>
      </section>
    )}
  </div>
</Layout>

<script>
  import { addToCart } from '../../lib/cart-client';

  const btn = document.getElementById('add-to-cart-detail') as HTMLButtonElement | null;
  const cantidadInput = document.getElementById('cantidad') as HTMLInputElement | null;

  btn?.addEventListener('click', () => {
    const cantidad = Math.max(1, Number(cantidadInput?.value ?? 1));
    addToCart(
      {
        productoId: Number(btn.dataset.id),
        nombre: btn.dataset.nombre ?? '',
        slug: btn.dataset.slug ?? '',
        precio: Number(btn.dataset.precio),
        imagenUrl: btn.dataset.imagen || null,
      },
      cantidad,
    );
    const original = btn.textContent;
    btn.textContent = 'Agregado ✓';
    setTimeout(() => {
      btn.textContent = original;
    }, 1200);
  });
</script>
