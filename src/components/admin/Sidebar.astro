---
const { pathname } = Astro.url;

const links = [
  { href: '/admin', label: 'Panel', exact: true },
  { href: '/admin/productos', label: 'Productos' },
  { href: '/admin/categorias', label: 'Categorias' },
  { href: '/admin/pedidos', label: 'Pedidos' },
];

function isActive(href: string, exact?: boolean) {
  return exact ? pathname === href : pathname.startsWith(href);
}
---

<aside class="w-56 shrink-0 border-r border-neutral-800 bg-neutral-950 p-4">
  <a href="/admin" class="mb-8 block text-lg font-black tracking-tight">
    IRON<span class="text-brand-500">FUEL</span> <span class="text-xs font-normal text-neutral-500">admin</span>
  </a>
  <nav class="flex flex-col gap-1 text-sm">
    {links.map((link) => (
      <a
        href={link.href}
        class:list={[
          'rounded-lg px-3 py-2 font-medium transition',
          isActive(link.href, link.exact)
            ? 'bg-brand-500 text-neutral-950'
            : 'text-neutral-300 hover:bg-neutral-900 hover:text-neutral-50',
        ]}
      >
        {link.label}
      </a>
    ))}
  </nav>
  <form method="POST" action="/admin/logout" class="mt-8">
    <button type="submit" class="w-full rounded-lg border border-neutral-800 px-3 py-2 text-left text-sm text-neutral-400 hover:border-neutral-600 hover:text-neutral-200">
      Cerrar sesion
    </button>
  </form>
</aside>
